<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:Avalonia.Input.TextInput;assembly=Avalonia.Base"
             xmlns:controls="using:Timer.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Timer.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="520" d:DesignHeight="820"
             x:Class="Timer.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="#A25E49" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="Foreground" Value="#292D28" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#77736B" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TabStripItem.modeTab">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#625F57" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="5,12" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TabStripItem.modeTab:selected">
      <Setter Property="Background" Value="#B96B50" />
      <Setter Property="Foreground" Value="#FFFDF9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabStripItem.modeTab:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="#B96B50" />
      <Setter Property="Foreground" Value="#FFFDF9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20,17" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="#A85D44" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="#F5F0E7" />
      <Setter Property="Foreground" Value="#524F47" />
      <Setter Property="BorderBrush" Value="#E8E0D4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20,17" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.timeInput">
      <Setter Property="input:TextInputOptions.ContentType" Value="Digits" />
      <Setter Property="Background" Value="#FFFCF7" />
      <Setter Property="Foreground" Value="#292D28" />
      <Setter Property="BorderBrush" Value="#DED5C8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Background="#F3EFE8"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="640" HorizontalAlignment="Stretch" Margin="22,24,22,32">
      <StackPanel Spacing="18">
        <Border Background="#FFFCF7" BorderBrush="#E7DFD4" BorderThickness="1"
                CornerRadius="16" Padding="6">
          <TabStrip SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
            <TabStrip.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
              </ItemsPanelTemplate>
            </TabStrip.ItemsPanel>
            <TabStripItem Classes="modeTab">Stopwatch</TabStripItem>
            <TabStripItem Classes="modeTab">Count up</TabStripItem>
            <TabStripItem Classes="modeTab">Countdown</TabStripItem>
            <TabStripItem Classes="modeTab">Intervals</TabStripItem>
          </TabStrip>
        </Border>

        <Border Background="#FFFCF7" BorderBrush="#E7DFD4" BorderThickness="1"
                CornerRadius="20" Padding="22,22,22,20">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="heading" Text="{Binding ModeTitle}" />
              <Border Grid.Column="1" Background="#F4E6DC" CornerRadius="12"
                      Padding="10,5" VerticalAlignment="Top" Margin="10,0,0,0">
                <TextBlock Classes="kicker" Text="{Binding StatusLabel}" />
              </Border>
            </Grid>

            <Border x:Name="TimeDisplayPanel" Background="#F8F3EB" CornerRadius="18" Padding="16,20">
              <Grid RowDefinitions="*,Auto" RowSpacing="7">
                <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <Grid>
                    <!-- Reserve room for three-digit hours so changes in the readout do not rescale it. -->
                    <TextBlock Text="000:00:00" FontSize="70" FontWeight="SemiBold" FontFeatures="tnum"
                               Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{Binding DisplayTime}" FontSize="70" FontWeight="SemiBold" FontFeatures="tnum"
                               Foreground="#292D28" HorizontalAlignment="Center" />
                  </Grid>
                </Viewbox>
                <TextBlock Grid.Row="1" Classes="muted" IsVisible="{Binding HasDetailLabel}" Text="{Binding DetailLabel}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Grid Height="7">
              <ProgressBar IsVisible="{Binding HasProgress}" Value="{Binding ProgressPercent}"
                           Minimum="0" Maximum="100" Height="7"
                           Foreground="#B96B50" Background="#EDE5DA" />
            </Grid>

            <Grid Height="32">
              <CheckBox Content="Sound" IsVisible="{Binding ShowSoundSetting}"
                        IsChecked="{Binding IsSoundEnabled, Mode=TwoWay}"
                        HorizontalAlignment="Right" Foreground="#625F57"
                        ToolTip.Tip="Play a short sound at the end of each countdown"
                        AutomationProperties.Name="Sound" />
            </Grid>

            <Grid ColumnDefinitions="2*,*">
              <Button Grid.Column="0" Classes="action" Margin="0,0,6,0" Height="56"
                      ToolTip.Tip="{Binding PrimaryActionLabel}"
                      AutomationProperties.Name="{Binding PrimaryActionLabel}"
                      Command="{Binding StartOrPauseCommand}">
                <Viewbox Width="22" Height="22">
                  <Canvas Width="24" Height="24">
                    <Path IsVisible="{Binding !IsTimerRunning}" Data="M7,3 L21,12 L7,21 Z"
                          Fill="#FFFDF9" />
                    <Path IsVisible="{Binding IsTimerRunning}" Data="M6,3 L10,3 L10,21 L6,21 Z M14,3 L18,3 L18,21 L14,21 Z"
                          Fill="#FFFDF9" />
                  </Canvas>
                </Viewbox>
              </Button>
              <Button Grid.Column="1" Classes="secondary" Margin="6,0,0,0" Height="56"
                      ToolTip.Tip="Reset" AutomationProperties.Name="Reset timer" Command="{Binding ResetCommand}">
                <Viewbox Width="22" Height="22">
                  <Canvas Width="24" Height="24">
                    <Path Data="M20,10 A8,8 0 0 0 6,6 M20,4 L20,10 L14,10 M4,14 A8,8 0 0 0 18,18 M4,20 L4,14 L10,14"
                          Stroke="#524F47" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                  </Canvas>
                </Viewbox>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsDurationMode}"
                Background="#FFFCF7" BorderBrush="#E7DFD4" BorderThickness="1"
                CornerRadius="20" Padding="18">
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Classes="heading" Text="Target time" />
            </StackPanel>
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Classes="muted" Text="Minutes" />
                <controls:DigitsOnlyTextBox Classes="timeInput" IsReadOnly="{Binding !CanEditSettings}" Text="{Binding DurationMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="3" PlaceholderText="0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="muted" Text="Seconds" />
                <controls:DigitsOnlyTextBox Classes="timeInput" IsReadOnly="{Binding !CanEditSettings}" Text="{Binding DurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="2" PlaceholderText="0" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsIntervalsSelected}" IsEnabled="{Binding CanEditSettings}"
                Background="#FFFCF7" BorderBrush="#E7DFD4" BorderThickness="1"
                CornerRadius="20" Padding="18">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Classes="muted" Text="Prepare · min" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding PreparationMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="3" PlaceholderText="0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="muted" Text="Prepare · sec" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding PreparationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="2" PlaceholderText="0" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Classes="muted" Text="Work · min" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding WorkMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="3" PlaceholderText="0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="muted" Text="Work · sec" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding WorkSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="2" PlaceholderText="45" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Classes="muted" Text="Rest · min" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding RestMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="3" PlaceholderText="0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="muted" Text="Rest · sec" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding RestSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="2" PlaceholderText="15" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" Text="Rounds" />
              <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding Rounds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       MaxLength="2" PlaceholderText="1" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="#FFFCF7" BorderBrush="#E7DFD4" BorderThickness="1"
                CornerRadius="20" Padding="18">
          <StackPanel Spacing="14">
            <TextBlock Classes="heading" Text="History" />
            <TextBlock Classes="muted" Text="No timers yet."
                       IsVisible="{Binding HasNoHistory}" />
            <ItemsControl ItemsSource="{Binding HistoryItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TimerHistoryItemViewModel">
                  <Border Background="#F8F3EB" CornerRadius="14" Padding="10"
                          Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                      <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="{Binding ModeLabel}"
                               MaxLength="80" AcceptsReturn="False"
                               AutomationProperties.Name="Timer name" ToolTip.Tip="Rename timer"
                               FontWeight="SemiBold" FontSize="14" Foreground="#292D28"
                               Background="Transparent" BorderBrush="#DED5C8"
                               BorderThickness="0,0,0,1" Padding="0,3" MinHeight="26"
                               HorizontalContentAlignment="Left" />
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Classes="muted" FontSize="10"
                                   Text="{Binding DurationLabel}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="1" IsVisible="{Binding ShowStatus}"
                                Background="#F4E6DC" CornerRadius="10"
                                Padding="3,3" Margin="2,0,0,0" VerticalAlignment="Center">
                          <TextBlock Classes="kicker" FontSize="10" Text="{Binding StatusLabel}" />
                        </Border>
                        <Button Grid.Column="1" IsVisible="{Binding CanRestart}"
                                Classes="secondary" Command="{Binding RestartCommand}"
                                ToolTip.Tip="Restart" AutomationProperties.Name="Restart timer"
                                Background="#F4E6DC" Foreground="#A25E49" BorderThickness="0"
                                Width="32" Height="32" Padding="7" Margin="2,0,0,0" CornerRadius="9">
                          <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                              <Path Data="M20,11 A8,8 0 1 0 18,18 M20,4 L20,11 L13,11"
                                    Stroke="#A25E49" StrokeThickness="2" StrokeLineCap="Round"
                                    StrokeJoin="Round" />
                            </Canvas>
                          </Viewbox>
                        </Button>
                        <Button Grid.Column="1" IsVisible="{Binding CanStop}"
                                Classes="secondary" Command="{Binding StopCommand}"
                                ToolTip.Tip="Stop" AutomationProperties.Name="Stop timer"
                                Background="#F4E6DC" Foreground="#A25E49" BorderThickness="0"
                                Width="32" Height="32" Padding="7" Margin="2,0,0,0" CornerRadius="9">
                          <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                              <Path Data="M5,5 L19,5 L19,19 L5,19 Z" Fill="#A25E49" />
                            </Canvas>
                          </Viewbox>
                        </Button>
                        <Button Grid.Column="2" Classes="secondary" Command="{Binding DeleteCommand}"
                                ToolTip.Tip="Delete" AutomationProperties.Name="Delete timer"
                                Width="32" Height="32" Padding="7" Margin="2,0,0,0" CornerRadius="9">
                          <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                              <Path Data="M3,6 L21,6 M9,6 L9,3 L15,3 L15,6 M5,6 L6,21 L18,21 L19,6 M10,10 L10,17 M14,10 L14,17"
                                    Stroke="#524F47" StrokeThickness="2" StrokeLineCap="Round"
                                    StrokeJoin="Round" />
                            </Canvas>
                          </Viewbox>
                        </Button>
                      </Grid>
                      <TextBlock Classes="muted" Text="{Binding SettingsLabel}"
                                 IsVisible="{Binding HasSettingsLabel}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
