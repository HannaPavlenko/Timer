<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:Avalonia.Input.TextInput;assembly=Avalonia.Base"
             xmlns:controls="using:Timer.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Timer.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="520" d:DesignHeight="820"
             x:Class="Timer.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="#A25E49" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="Foreground" Value="#292D28" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#77736B" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TabStripItem.modeTab">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#625F57" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="5,12" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TabStripItem.modeTab:selected">
      <Setter Property="Background" Value="#B96B50" />
      <Setter Property="Foreground" Value="#FFFDF9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabStripItem.modeTab:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="#B96B50" />
      <Setter Property="Foreground" Value="#FFFDF9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20,17" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="#A85D44" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="#F5F0E7" />
      <Setter Property="Foreground" Value="#524F47" />
      <Setter Property="BorderBrush" Value="#E8E0D4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20,17" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.timeInput">
      <Setter Property="input:TextInputOptions.ContentType" Value="Digits" />
      <Setter Property="Background" Value="#FFFCF7" />
      <Setter Property="Foreground" Value="#292D28" />
      <Setter Property="BorderBrush" Value="#DED5C8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Background="#F3EFE8"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="640" HorizontalAlignment="Stretch" Margin="22,24,22,32">
      <StackPanel Spacing="18">
        <Border Background="#FFFCF7" BorderBrush="#E7DFD4" BorderThickness="1"
                CornerRadius="16" Padding="6">
          <TabStrip SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
            <TabStrip.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
              </ItemsPanelTemplate>
            </TabStrip.ItemsPanel>
            <TabStripItem Classes="modeTab">Stopwatch</TabStripItem>
            <TabStripItem Classes="modeTab">Count up</TabStripItem>
            <TabStripItem Classes="modeTab">Countdown</TabStripItem>
            <TabStripItem Classes="modeTab">Intervals</TabStripItem>
          </TabStrip>
        </Border>

        <Border Background="#FFFCF7" BorderBrush="#E7DFD4" BorderThickness="1"
                CornerRadius="20" Padding="22,22,22,20">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="heading" Text="{Binding ModeTitle}" />
              <Border Grid.Column="1" Background="#F4E6DC" CornerRadius="12"
                      Padding="10,5" VerticalAlignment="Top" Margin="10,0,0,0">
                <TextBlock Classes="kicker" Text="{Binding StatusLabel}" />
              </Border>
            </Grid>

            <Border Background="#F8F3EB" CornerRadius="18" Padding="16,24">
              <StackPanel Spacing="7" HorizontalAlignment="Stretch">
                <TextBlock Classes="kicker" Text="{Binding PhaseLabel}"
                           HorizontalAlignment="Center" />
                <Viewbox Stretch="Uniform" MaxHeight="82" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding DisplayTime}" FontSize="70" FontWeight="SemiBold"
                             Foreground="#292D28" />
                </Viewbox>
                <TextBlock Classes="muted" Text="{Binding DetailLabel}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <ProgressBar IsVisible="{Binding HasProgress}" Value="{Binding ProgressPercent}"
                         Minimum="0" Maximum="100" Height="7"
                         Foreground="#B96B50" Background="#EDE5DA" />

            <Grid ColumnDefinitions="2*,*">
              <Button Grid.Column="0" Classes="action" Margin="0,0,6,0"
                      Content="{Binding PrimaryActionLabel}" Command="{Binding StartOrPauseCommand}" />
              <Button Grid.Column="1" Classes="secondary" Margin="6,0,0,0"
                      Content="Reset" Command="{Binding ResetCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsDurationMode}" IsEnabled="{Binding CanEditSettings}"
                Background="#FFFCF7" BorderBrush="#E7DFD4" BorderThickness="1"
                CornerRadius="20" Padding="18">
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Classes="heading" Text="Target time" />
            </StackPanel>
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Classes="muted" Text="Minutes" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding DurationMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="3" PlaceholderText="0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="muted" Text="Seconds" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding DurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="2" PlaceholderText="0" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsIntervalsSelected}" IsEnabled="{Binding CanEditSettings}"
                Background="#FFFCF7" BorderBrush="#E7DFD4" BorderThickness="1"
                CornerRadius="20" Padding="18">
          <StackPanel Spacing="16">
            <StackPanel Spacing="3">
              <TextBlock Classes="kicker" Text="02  SHAPE YOUR SESSION" />
              <TextBlock Classes="heading" Text="Prepare, work, rest" />
            </StackPanel>
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Classes="muted" Text="Prepare · min" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding PreparationMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="3" PlaceholderText="0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="muted" Text="Prepare · sec" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding PreparationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="2" PlaceholderText="10" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Classes="muted" Text="Work · min" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding WorkMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="3" PlaceholderText="0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="muted" Text="Work · sec" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding WorkSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="2" PlaceholderText="45" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Classes="muted" Text="Rest · min" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding RestMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="3" PlaceholderText="0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="muted" Text="Rest · sec" />
                <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding RestSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="2" PlaceholderText="15" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" Text="Rounds" />
              <controls:DigitsOnlyTextBox Classes="timeInput" Text="{Binding Rounds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       MaxLength="2" PlaceholderText="4" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding HasError}" Background="#F9E9E2"
                BorderBrush="#E7C7B9" BorderThickness="1" CornerRadius="12" Padding="14,11">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#8B4938" TextWrapping="Wrap" />
        </Border>

      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
